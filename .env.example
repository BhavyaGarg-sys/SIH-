# BIS RAG System Configuration

# Path Configuration
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
VECTORSTORE_PATH=data/vectorstore

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Compute Device (auto, cpu, cuda, mps)
DEVICE=auto

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval Configuration
TOP_K=4

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here

# Database Configuration
MONGO_URL=mongodb://localhost:27017

# Authentication
# Required: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# The application refuses to start if this value is blank, the placeholder, or shorter than 32 characters.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Comma-separated browser origins permitted to call the API. Do not use * when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
